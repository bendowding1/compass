# --- Auth (Unit 3 — Microsoft Entra ID via Auth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Single-tenant issuer restricts sign-in to your employees:
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Not needed on Vercel (Auth.js detects it). Required when running the
# production build anywhere else — locally via `npm start`, or behind
# another proxy/CDN.
AUTH_TRUST_HOST=true

# --- Git data store (Unit 4 — GitHub App preferred, or a fine-grained service PAT) ---
# The data repo stays under the N-AndGroup org even though the app repo is
# hosted elsewhere — the token below is what bridges the two (its resource
# owner must be N-AndGroup).
COMPASS_DATA_OWNER=N-AndGroup
COMPASS_DATA_REPO=compass-data
# GitHub App (recommended):
COMPASS_GITHUB_APP_ID=
COMPASS_GITHUB_APP_INSTALLATION_ID=
COMPASS_GITHUB_APP_PRIVATE_KEY=
# OR simpler v1: a fine-grained PAT scoped to the data repo (use one or the other):
COMPASS_GIT_TOKEN=

# --- Release downloads (optional — private S3 bucket, presign + redirect) ---
# When set, milestone release links that point at this bucket are served via
# Compass: folder URIs (e.g. s3://panattaversions/treadmill/official/1.0.0/)
# open an SSO-gated file listing at /release; single objects presign+redirect
# via /api/release. Leave unset to render raw links only.
COMPASS_RELEASE_BUCKET=panattaversions
# Read-only credentials for that bucket (IAM user `compass-app`, s3:GetObject +
# s3:ListBucket on the release bucket only). COMPASS_-prefixed because Vercel
# reserves the standard AWS_* names; off Vercel the standard names also work
# via the SDK's default provider chain (see src/lib/s3.ts).
COMPASS_AWS_REGION=
COMPASS_AWS_ACCESS_KEY_ID=
COMPASS_AWS_SECRET_ACCESS_KEY=
